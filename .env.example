# RAG 知识库问答系统环境变量配置
# 复制此文件为 .env 并根据需要修改配置

# ============ 应用信息 ============
APP_NAME="RAG Knowledge Base Q&A System"
APP_VERSION="1.0.0"
APP_DESCRIPTION="基于本地大模型的离线 RAG 知识库问答系统"

# ============ 路径配置 ============
# 注意：相对路径基于项目根目录
DOCS_DIR="./docs"
VECTOR_DB_DIR="./res/chroma_db"
MODEL_CACHE_DIR="./model_cache"
LOG_DIR="./logs"

# ============ 模型配置 ============
# Ollama 模型配置
LLM_MODEL_NAME="qwen:4b"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Ollama 嵌入模型配置
EMBED_MODEL_NAME="mofanke/dmeta-embedding-zh"
EMBED_MODEL_DEVICE="cpu"
EMBED_NORMALIZE=true

# ============ 文档处理配置 ============
# 文本分割配置
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ============ 向量检索配置 ============
# 向量数据库配置
VECTOR_DB_TYPE="chroma"  # chroma/faiss/milvus/qdrant
VECTOR_DB_COLLECTION="rag_knowledge_base"
VECTOR_DB_PERSIST=true

# Milvus 配置
MILVUS_HOST="localhost"
MILVUS_PORT=19530
MILVUS_USER=""
MILVUS_PASSWORD=""

# Qdrant 配置
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_PREFER_GRPC=false

# 检索配置
DEFAULT_TOP_K=3
FETCH_K=10
LAMBDA_MULT=0.7
SEARCH_TYPE="mmr"  # similarity 或 mmr

# ============ Web 服务配置 ============
WEB_HOST="0.0.0.0"
WEB_PORT=7801
WEB_DEBUG=false
WEB_SHARE=false

# ============ 日志配置 ============
LOG_LEVEL="INFO"
# LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ============ 性能配置 ============
MAX_CONTEXT_LENGTH=1800
REQUEST_TIMEOUT=30
CACHE_ENABLED=true

# ============ Docker 部署配置 ============
# Ollama 服务配置
OLLAMA_HOST="http://ollama:11434"
OLLAMA_KEEP_ALIVE="24h"

# 容器资源限制（可选）
# CONTAINER_MEMORY_LIMIT="4g"
# CONTAINER_CPU_LIMIT="2"

# 网络配置
# DOCKER_NETWORK="rag-network"

# 数据卷配置
# VOLUME_PREFIX="./"  # Windows 使用 "./"，Linux/Mac 使用 "."
MAX_CONTEXT_LENGTH=1800
REQUEST_TIMEOUT=30
CACHE_ENABLED=true

# ============ 安全配置 ============
# 允许的跨域来源，用逗号分隔
ALLOWED_ORIGINS="http://localhost:7801,http://127.0.0.1:7801"

# ============ HuggingFace 配置 ============
# 如果需要访问私有模型或需要更高速率限制，请设置以下令牌
# HF_TOKEN="your_huggingface_token_here"

# ============ Ollama 配置 ============
# Ollama 服务器地址，如果不在本地运行
# OLLAMA_HOST="http://localhost:11434"

# ============ 高级配置 ============
# 文本清理配置
MIN_DOC_LENGTH=10
MAX_DOC_LENGTH=10000

# 向量数据库配置（已移至向量检索配置部分）

# 重试配置
MAX_RETRIES=3
RETRY_DELAY=1.0

# 注意：
# 1. 布尔值使用 true/false（小写）
# 2. 列表值使用逗号分隔
# 3. 路径使用正斜杠，即使是在 Windows 上
# 4. 所有配置都可以通过环境变量覆盖